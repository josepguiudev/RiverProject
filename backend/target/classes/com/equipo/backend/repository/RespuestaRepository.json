      "signature": "public abstract void com.equipo.backend.repository.RespuestaRepository.deleteByUserIdAndOption_Question_Survey_Id(java.lang.Long,java.lang.Long)",
      "query": {
        "query": "SELECT r FROM Respuesta r LEFT JOIN r.option o LEFT JOIN o.question q LEFT JOIN q.survey s WHERE r.user.id = :userId AND s.id = :surveyId"
      }
